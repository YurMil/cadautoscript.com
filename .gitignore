# Dependencies
/node_modules

# Production
/build
/dev new utility
/dist

# Generated files
.docusaurus
.cache-loader

# Misc
.DS_Store

# Environment files hold keys (Supabase service role, Resend, …); never commit
# them. Covers .env, .env.production, supabase/functions/.env and the *.local
# variants. Only a placeholder-only example may be committed.
.env
.env.*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code local state (worktrees, etc.)
.claude/

# Sourcemaps from pre-built utility bundles (issue #57): don't recommit them
static/utility-apps/**/*.map

# Generated by ANALYZE=1 builds
bundle-report.html

# Disposable malformed-PDF fixtures (scripts/make-pdf-fixtures.mjs)
.pdf-fixtures/
