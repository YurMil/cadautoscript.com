    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "replicad": "^0.20.5",
    "replicad-opencascadejs": "^0.20.2",
    "three": "^0.182.0",
    "three-stdlib": "2.36.1",
    "uuid": "^13.0.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.15",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": "22.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "core-js",
      "core-js-pure",
      "sharp"
    ],
    "overrides": {
      "dompurify@<3.4.5": "^3.4.5"
    }
  }
