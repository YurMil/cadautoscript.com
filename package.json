{
  "name": "cadautoscript-site",
  "version": "1.0.0",
  "description": "CAD AutoScript documentation and utility catalog powered by Docusaurus.",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/YurMil/cadautoscript.com.git"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "prebuild": "node scripts/optimize-thumbnails.js && node scripts/optimize-screenshots.js",
    "build": "docusaurus build",
    "postbuild": "node scripts/sitemap-sections.js",
    "optimize:thumbnails": "node scripts/optimize-thumbnails.js",
    "optimize:screenshots": "node scripts/optimize-screenshots.js",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "sitemap:sections": "node scripts/sitemap-sections.js",
    "sync:webstep-viewer": "node scripts/sync-webstep-viewer-embed.js",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
