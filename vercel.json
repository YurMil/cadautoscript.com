{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.cadautoscript.com"
        }
      ],
      "destination": "https://cadautoscript.com/:path*",
      "permanent": true
    },
    {
      "source": "/games",
      "destination": "/mini-games/",
      "permanent": true
    },
    {
      "source": "/games/eco-sort",
      "destination": "/mini-games/eco-sort-game/",
      "permanent": true
    },
    {
      "source": "/games/:slug*",
      "destination": "/mini-games/:slug*/",
      "permanent": true
    }
  ]
}

