{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/utility-apps/(.*)/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.cadautoscript.com"
        }
      ],
      "destination": "https://cadautoscript.com/:path*",
      "permanent": true
    },
    {
      "source": "/docs/blind-flange-calculator-microarchitecture-migration/",
      "destination": "/docs/utilities/blind-flange-calculator/",
      "permanent": true
    },
    {
      "source": "/docs/tube-sheet-generator-microarchitecture-migration/",
      "destination": "/docs/utilities/tube-sheet-generator/",
      "permanent": true
    },
    {
      "source": "/docs/guides/:slug*",
      "destination": "/docs/intro/",
      "permanent": true
    },
    {
      "source": "/games",
      "destination": "/mini-games/",
      "permanent": true
    },
    {
      "source": "/games/eco-sort",
      "destination": "/mini-games/eco-sort-game/",
      "permanent": true
    },
    {
      "source": "/games/:slug*",
      "destination": "/mini-games/:slug*/",
      "permanent": true
    }
  ]
}

